# Configuration for the server.
#
# Rename this file to `.env`. The server loads `.env` from the working
# directory at startup; real process environment variables override entries in
# this file.
#
# There is no API key here and there must not be one. The server is bring your
# own key: each person pastes their Gemini API key into the app, and the app
# sends it with each request. The server uses it for that request only and
# never stores it.

# Browser origins allowed to call the API, comma separated. Unset means no
# browser origin is allowed. For local Flutter web, run with a fixed port, for
# example `--web-port 3000`, and list `http://localhost:3000` here.
HOME_CORS_ALLOWED_ORIGINS=http://localhost:3000

######### OPTIONAL
#
# Override the default Gemini model.
# HOME_LLM_MODEL=
#
# To change the assistant's persona and rules, edit
# `assets/system-prompt.prompt`.
